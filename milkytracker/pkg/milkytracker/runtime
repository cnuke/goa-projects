<runtime ram="80M" caps="500" binary="init">

	<requires>
		<gui/>
		<play/>
		<timer/>
		<file_system label="home"/>
		<file_system label="media"/>
	</requires>

	<content>
		<rom label="black_hole"/>
		<rom label="egl.lib.so"/>
		<rom label="expat.lib.so"/>
		<rom label="glapi.lib.so"/>
		<rom label="init"/>
		<rom label="ld.lib.so"/>
		<rom label="libc.lib.so"/>
		<rom label="libdrm.lib.so"/>
		<rom label="libiconv.lib.so"/>
		<rom label="libm.lib.so"/>
		<rom label="mesa.lib.so"/>
		<rom label="milky.xm"/>
		<rom label="milkytracker"/>
		<rom label="sdl2.lib.so"/>
		<rom label="stdcxx.lib.so"/>
		<rom label="vfs.lib.so"/>
		<rom label="vfs_gpu.lib.so"/>
		<rom label="vfs_oss.lib.so"/>
		<rom label="zlib.lib.so"/>
	</content>

	<config>
		<parent-provides>
			<service name="ROM"/>
			<service name="PD"/>
			<service name="RM"/>
			<service name="CPU"/>
			<service name="LOG"/>
			<service name="Gui"/>
			<service name="Timer"/>
			<service name="Gpu"/>
			<service name="Play"/>
			<service name="File_system"/>
		</parent-provides>

		<default-route> <any-service> <parent/> <any-child/> </any-service> </default-route>

		<start name="black_hole" caps="100">
			<resource name="RAM" quantum="1M"/>
			<provides> <service name="ROM"/> <service name="Gpu"/> </provides>
				<config>
					<rom/> <gpu/>
				</config>
			<route>
				<any-service> <parent/> <any-child/> </any-service>
			</route>
		</start>

		<start name="milkytracker" caps="250">
			<resource name="RAM" quantum="64M"/>
			<exit propagate="yes"/>
			<config ld_verbose="yes">
				<initial width="1024" height="768"/>
				<env key="NO_OPENGL" value="1"/>
				<vfs>
					<dir name="dev">
						<log/> <oss name="dsp" record_enabled="false"/> <gpu/>
						<inline name="rtc">2023-09-21 12:00</inline>
					</dir>
					<dir name="tmp">
						<ram/>
						<rom name="milky.xm"/>
					</dir>
					<dir name="home">
						<fs label="home"/>
					</dir>
					<dir name="media">
						<fs label="media"/>
					</dir>
				</vfs>
				<libc stdout="/dev/log" stderr="/dev/log" rtc="/dev/rtc"/>
			</config>
			<route>
				<service name="File_system" label="home">  <parent label="home"/> </service>
				<service name="File_system" label="media"> <parent label="media"/> </service>
				<service name="ROM" label="mesa_gpu_drv.lib.so">
					<child name="black_hole"/>
				</service>
				<service name="Gpu"> <child name="black_hole"/> </service>
				<any-service> <parent/> <any-child/> </any-service>
			</route>
		</start>
	</config>

</runtime>
